# 默认使用本机 SQLite，无需安装数据库。数据在 .data/ 中，不能提交到 Git。
DATABASE_URL=
# 仅在启用可选 PostgreSQL 记忆存储后填写：
# DATABASE_URL=postgres://knowledge:knowledge@127.0.0.1:54329/knowledge_v2

# 候选记忆默认由本地规则提取，不产生外部调用。
# 只有显式开启后，才会把来源文本发给兼容 Chat Completions 的服务；失败时自动回退本地规则。
MEMORY_EXTRACTION_ENABLED=false
MEMORY_EXTRACTOR_URL=
MEMORY_EXTRACTOR_API_KEY=
MEMORY_EXTRACTOR_MODEL=

# AI 工作区。可直接复用 V1 的 Hugging Face 配置：
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-32B

# 或连接任意兼容 Chat Completions 的服务。设置此组后优先使用此组。
AI_CHAT_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=

# 仅供 pnpm test:db 使用；数据库名必须包含 test，防止误清理生产数据。
TEST_DATABASE_URL=postgres://knowledge:knowledge@127.0.0.1:54329/knowledge_v2_test
